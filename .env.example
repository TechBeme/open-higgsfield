# Production operator setup: docs/production.md. Never use NEXT_PUBLIC_ for secrets.
# One shared workspace; this is not multi-user ownership or a monetary budget.
# Credential-free development requires loopback origin and binding (npm run dev).
# APP_ORIGIN=https://studio.example.com
# APP_ACCESS_USER=operator
# APP_ACCESS_PASSWORD=<random-printable-secret-at-least-32-characters>
# Production defaults to disabled. Enable only after quotas/storage/background-execution checks.
# GENERATION_ENABLED=false

# Encrypts provider connection secrets saved from /<locale>/settings.
# Keep this stable across restarts and back it up separately from the database.
# PROVIDER_CONFIG_ENCRYPTION_KEY=<random-printable-secret-at-least-32-characters>

# Choose explicitly in production: single-process or distributed.
# DEPLOYMENT_PROFILE=single-process
# TASK_WORKER_MODE=local
# Vercel: migrated DATABASE_URL + Blob/S3; Fluid compute + system env vars enabled.
# DEPLOYMENT_PROFILE=distributed
# TASK_WORKER_MODE=workflow
# The SDK uses VERCEL_DEPLOYMENT_ID automatically. No CRON_SECRET is needed.
# Optional external worker profile (other hosts): requires DATABASE_URL,
# distinct CRON_SECRET and an independently installed recurring trigger.
# TASK_WORKER_MODE=external
# CRON_SECRET=<different-random-secret-at-least-32-characters>
# TASK_SCHEDULER_CONFIGURED=true
# Default 24 hours; integer range 30 minutes to 7 days.
# TASK_OBSERVATION_TIMEOUT_MS=86400000

# Magnific
MAGNIFIC_API_KEY=

# Google AI Studio (GEMINI_API_KEY is the preferred name)
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS, or
# provide the service-account JSON inline in one of these variables:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_CREDENTIALS=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Runware (or add one or more encrypted connections in Providers)
RUNWARE_API_KEY=

# Optional ToAPIs provider (server-side credentials only)
TOAPIS_API_KEY=
# Only this exact HTTPS origin is supported, without /v1:
# TOAPIS_BASE_URL=https://toapis.com

# Optional PostgreSQL / Neon persistence for task metadata (never new media bytes)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional legacy public hosting (not needed with Blob/S3)
CLOUDINARY_URL=
# Or configure the three values below instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Media storage: vercel-blob (recommended on Vercel), s3, local, or cloudinary.
# DATABASE_URL / VERCEL requires durable object storage (not local).
# ASSET_STORAGE_MODE=vercel-blob
# Private is the default for Blob/S3. Use a PRIVATE Blob store with this setting.
# ASSET_DELIVERY_MODE=private
# Automatically supplied when a Blob store is connected to the Vercel project.
# BLOB_READ_WRITE_TOKEN=
# Optional store ID override, e.g. store_abc123 (normally inferred from the token).
# BLOB_STORE_ID=

# Alternative: ASSET_STORAGE_MODE=s3, private bucket, GetObject/PutObject permissions.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# Unset access keys use the native AWS credential chain (e.g. IAM role).
# Optional HTTPS endpoint for S3-compatible services; region may be auto.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# Only when explicitly using ASSET_DELIVERY_MODE=public:
# S3_PUBLIC_BASE_URL=https://media.example.com

# Legacy Cloudinary requires ASSET_DELIVERY_MODE=public (originals public by URL).

# Production local mode requires an explicit absolute persistent disk directory.
# Ephemeral /tmp does not provide durable local storage on serverless deployments.
# OPEN_HIGGSFIELD_STORAGE_DIR=/absolute/path/to/open-higgsfield-data
# Veo 3.1 regional endpoint (Vertex); use the documented supported region.
GOOGLE_VEO_LOCATION=us-central1
