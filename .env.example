# Freepik
FREEPIK_API_KEY=

# Google AI Studio (GEMINI_API_KEY is the preferred name)
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS, or
# provide the service-account JSON inline in one of these variables:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_CREDENTIALS=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Temporary public hosting for input media
CLOUDINARY_URL=
# Or configure the three values below instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional local runtime storage directory.
# Vercel automatically uses /tmp/flow-ai-studio (ephemeral storage).
# FLOW_STORAGE_DIR=/absolute/path/to/flow-data
